      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>breezeFur</id>
      <name>breezeFur</name>
      <email>voidexl@outlook.com</email>
      <url>https://github.com/breezeFur</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/breezeFur/yuanbaomao-base.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/breezeFur/yuanbaomao-base.git</developerConnection>
    <url>https://github.com/breezeFur/yuanbaomao-base</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations-jakarta</artifactId>
      <version>2.2.52</version>
      <scope>compile</scope>
