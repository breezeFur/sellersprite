    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <groupId>cyou.yuanbaomao</groupId>
  <artifactId>yuanbaomao-base</artifactId>
  <version>0.1.1</version>
  <name>yuanbaomao-base</name>
