<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cyou.yuanbaomao</groupId>
        <artifactId>sellersprite-service</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>sellersprite-graph-learning</artifactId>
    <name>sellersprite-graph-learning</name>
    <description>Alibaba Graph 通用教学脚手架与业务集成示例</description>

    <properties>
        <spring-ai-alibaba-graph.version>2.0.0-M1.1</spring-ai-alibaba-graph.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-graph-core</artifactId>
            <version>${spring-ai-alibaba-graph.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>project-integration</id>
            <dependencies>
                <dependency>
                    <groupId>cyou.yuanbaomao</groupId>
                    <artifactId>sellersprite-ai</artifactId>
                    <version>${project.version}</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>cyou.yuanbaomao</groupId>
                    <artifactId>sellersprite-research-graph</artifactId>
                    <version>${project.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <graph.learning.project-integration>true</graph.learning.project-integration>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
